# Distributed LLM — Tailscale Deployment Configuration
# Copy this file to .env and fill in your Tailscale IPs.

# --- Role selection ---
# Set to: load_balancer | master | worker
ROLE=load_balancer

# --- Load Balancer ---
LOAD_BALANCER_HOST=0.0.0.0
LOAD_BALANCER_PORT=8000

# Master URL the LB forwards requests to (must include /query path)
MASTER_URL=http://100.103.28.116:9000/query

# --- Master ---
MASTER_HOST=0.0.0.0
MASTER_PORT=9000

# Comma-separated list of worker /query URLs
WORKER_URLS=http://100.66.241.32:8001/query,http://100.66.241.32:8002/query,http://100.124.230.6:8003/query,http://100.124.230.6:8004/query

# --- Worker ---
WORKER_HOST=0.0.0.0
# Ports to run workers on (on this machine)
WORKER_PORTS=8001,8002,8003,8004
WORKER_ID=worker-1
PORT=8001
